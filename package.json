{
  "name": "@jonathanjuliani/skillverse",
  "version": "0.2.4",
  "description": "Skillverse: every skill your AI agents have, as a globe, a graph and a tree, in the terminal and the browser.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "bin": {
    "skillverse": "bin/skillverse.mjs"
  },
  "files": [
    "bin/",
    "cli/",
    "server/",
    "web/",
    "tui/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node bin/skillverse.mjs run --dev",
    "dev:plugin": "CLAUDE_CODE_PLUGIN_DIR_WATCH=1 claude --plugin-dir . --debug-file .dev/debug.log",
    "dev:terminal": "pnpm run build && node tui/skillverse.mjs --scan",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "version": "node scripts/sync-version.mjs && biome format --write .claude-plugin/plugin.json .claude-plugin/marketplace.json && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json CHANGELOG.md",
    "check-version": "node scripts/sync-version.mjs --check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:plugin": "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 claude plugin test .",
    "validate": "claude plugin validate .claude-plugin/plugin.json && claude plugin validate .",
    "vscode:package": "cd vscode && npx --yes @vscode/vsce@3 package --no-dependencies",
    "snapshot": "node bin/skillverse.mjs --scan --snapshot 120x32 --frames 20 --plain"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "author": "Jonathan Juliani (https://github.com/jonathanjuliani)",
  "homepage": "https://github.com/jonathanjuliani/skillverse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanjuliani/skillverse.git"
  },
  "bugs": "https://github.com/jonathanjuliani/skillverse/issues",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "skills",
    "plugins",
    "tui",
    "terminal",
    "visualization"
  ],
  "publishConfig": {
    "access": "public"
  }
}
